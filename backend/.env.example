# Copy to ".env" for local development (never commit .env).
# REQUIRED: PostgreSQL connection strings.
# DATABASE_URL = runtime (use the pooled URL on a hosted DB, e.g. Neon "-pooler" host + ?sslmode=require&pgbouncer=true).
# DIRECT_URL   = direct, non-pooled URL used by `prisma migrate`. With no pooler (local, VPS) use the same URL for both.
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/acr_and_company_web?schema=public"
DIRECT_URL="postgresql://postgres:PASSWORD@localhost:5432/acr_and_company_web?schema=public"
# Uploaded images (served at /uploads) and private CVs live OUTSIDE the app folder so redeploys never touch them.
UPLOAD_DIR=../../acr-data/acr-and-company/uploads
PRIVATE_DIR=../../acr-data/acr-and-company/private

# REQUIRED: long random text used to sign admin login cookies (>= 32 characters in production).
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# First admin account, created by `npm run seed:admin` (password: 10+ characters). Remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# OPTIONAL: public base URL (no trailing slash) and port.
SITE_URL=http://localhost:3000
PORT=3000

# OPTIONAL: origins allowed to call the public API from a browser (the website dev servers).
CORS_ORIGINS=http://localhost:4400,http://localhost:4000

# OPTIONAL: outgoing email for form alerts (contact, consultation, job applications). If SMTP_HOST or SMTP_FROM is empty,
# submissions are still saved and the server only logs a warning.
SMTP_HOST=
SMTP_PORT=587
# true = TLS from the start (normally port 465). Leave empty to decide by port (465 = true, otherwise STARTTLS).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Shown as the sender, e.g.  ACR & Company <website@acrandcompany.com>
SMTP_FROM=

# OPTIONAL: ask search engines to ignore the whole site (test/staging address). Remove for the real site.
NOINDEX_SITE=
# OPTIONAL: number of reverse proxies in front of the API (default 1). See DEPLOY.md.
TRUST_PROXY=1
# OPTIONAL: folder with the seed source images (default prisma/seed-assets). Missing seeded images are re-created from it on start.
SEED_ASSETS_DIR=
