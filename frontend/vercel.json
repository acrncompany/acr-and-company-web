{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/browser",
  "cleanUrls": false,
  "functions": {
    "api/ssr.mjs": { "maxDuration": 30, "memory": 1024 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://acr-and-company-web-backend.onrender.com" },
    { "source": "/uploads/:path*", "destination": "https://acr-and-company-web-backend.onrender.com" },
    { "source": "/sitemap.xml", "destination": "https://acr-and-company-web-backend.onrender.com" },
    { "source": "/robots.txt", "destination": "https://acr-and-company-web-backend.onrender.com" },
    { "source": "/(favicon-32x32\\.png|apple-touch-icon\\.png|icon-192\\.png|icon-512\\.png|site\\.webmanifest)", "destination": "https://acr-and-company-web-backend.onrender.com" },
    { "source": "/((?!api/).*)", "destination": "/api/ssr" }
  ]
}
